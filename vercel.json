{
  "buildCommand": "NODE_ENV=production vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/ocr-exam.ts": {
      "maxDuration": 30
    },
    "api/clinical-reasoning.ts": {
      "maxDuration": 30
    }
  }
}
