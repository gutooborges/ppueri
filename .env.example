# ==============================================================================
# PPUERI - PRONTUÁRIO ELETRÔNICO PEDIÁTRICO (PEP) & PUERICULTURA
# Configuração de Variáveis de Ambiente para Produção e Desenvolvimento
# ==============================================================================

# 1. Inteligência Artificial / OCR de Laudos (Google Gemini API)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 2. Supabase — cliente React/Vite (prefixo VITE_ obrigatório para exposição ao browser)
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_..."

# 3. Supabase — servidor Express (sem prefixo VITE_)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_..."
# SUPABASE_SERVICE_ROLE_KEY="<service_role_key>"

# 4. Servidor Node.js / Express
PORT=3000
NODE_ENV="production"
APP_URL="https://seu-dominio-ppueri.com.br"
