# ==============================================================================
# PPUERI - PRONTUÁRIO ELETRÔNICO PEDIÁTRICO (PEP) & PUERICULTURA
# Configuração de Variáveis de Ambiente para Produção e Desenvolvimento
# ==============================================================================

# 1. Inteligência Artificial / OCR de Laudos (Google Gemini API)
# Necessária para a rota /api/ocr-exam (extração inteligente de laudos de exames em PDF/imagem)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 2. Servidor Node.js / Express
PORT=3000
NODE_ENV="production"

# 3. URL da Aplicação (usada para PWA, callbacks e cabeçalhos de segurança)
APP_URL="https://seu-dominio-ppueri.com.br"

# 4. Banco de Dados Relacional (Opcional para modo Multi-tenant / PostgreSQL / Supabase)
# Exemplo de string de conexão Postgres / Supabase:
# DATABASE_URL="postgresql://postgres:[SENHA]@db.[PROJECT-REF].supabase.co:5432/postgres"
# SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 5. Segurança & Criptografia de Sessão
SESSION_SECRET="ppueri_super_secret_pediatric_token_2026"
ENCRYPTION_KEY="32_bytes_hexadecimal_string_for_lgpd_protection"
